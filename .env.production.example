# ---------- APP ----------
APP_ENV=production
SECRET_KEY=REQUIRED_generate_a_long_random_secret
TOKEN_ENCRYPTION_KEY=REQUIRED_32_byte_encryption_key
LOG_LEVEL=INFO
PUBLIC_API_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# ---------- DATABASE ----------
POSTGRES_DB=channelai
POSTGRES_USER=channelai
POSTGRES_PASSWORD=REQUIRED_strong_password
DATABASE_URL=postgresql+asyncpg://channelai:REQUIRED_PASSWORD@postgres:5432/channelai

# ---------- REDIS ----------
REDIS_PASSWORD=REQUIRED_strong_password
REDIS_URL=redis://:REQUIRED_PASSWORD@redis:6379/0

# ---------- LLM ----------
AI_PROVIDER=openai_compatible
AI_API_KEY=REQUIRED
AI_MODEL=REQUIRED
AI_BASE_URL=https://api.openai.com/v1

# ---------- RESEARCH ----------
RESEARCH_PROVIDER=REQUIRED
RESEARCH_API_KEY=REQUIRED
RESEARCH_API_BASE_URL=REQUIRED

# ---------- TTS ----------
TTS_PROVIDER=REQUIRED
TTS_API_KEY=REQUIRED
TTS_API_BASE_URL=REQUIRED
TTS_VOICE_ID=REQUIRED

# ---------- MEDIA ----------
MEDIA_PROVIDER=REQUIRED
MEDIA_API_KEY=REQUIRED
MEDIA_API_BASE_URL=REQUIRED

# ---------- OBJECT STORAGE ----------
S3_BUCKET=REQUIRED
S3_ENDPOINT=REQUIRED
S3_REGION=REQUIRED
S3_ACCESS_KEY=REQUIRED
S3_SECRET_KEY=REQUIRED
PUBLIC_MEDIA_URL=https://media.example.com

# ---------- GOOGLE / YOUTUBE ----------
GOOGLE_CLIENT_ID=REQUIRED
GOOGLE_CLIENT_SECRET=REQUIRED
YOUTUBE_REDIRECT_URI=https://api.example.com/api/youtube/oauth/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly

# ---------- STRIPE ----------
STRIPE_SECRET_KEY=REQUIRED
STRIPE_WEBHOOK_SECRET=REQUIRED
STRIPE_PRICE_STARTER=REQUIRED
STRIPE_PRICE_CREATOR=REQUIRED
STRIPE_PRICE_PRO=REQUIRED
STRIPE_PRICE_AGENCY=REQUIRED

# ---------- EMAIL ----------
SMTP_HOST=REQUIRED
SMTP_PORT=587
SMTP_USERNAME=REQUIRED
SMTP_PASSWORD=REQUIRED
SMTP_FROM=noreply@example.com

# ---------- SECURITY / POLICY ----------
REQUIRE_HUMAN_APPROVAL=true
GENERATION_MONTHLY_LIMIT=10
MAX_VIDEO_MINUTES=30
MAX_UPLOAD_BYTES=2147483648

# ---------- MONITORING ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- LOCAL FALLBACKS ----------
STORAGE_LOCAL_DIR=/data/storage

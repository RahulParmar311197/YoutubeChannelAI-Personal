APP_ENV=personal
SECRET_KEY=CHANGE_ME
TOKEN_ENCRYPTION_KEY=CHANGE_ME
LOG_LEVEL=INFO

# Local app
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Local database / queue
DATABASE_URL=postgresql+asyncpg://channelai:channelai@postgres:5432/channelai
REDIS_URL=redis://redis:6379/0

# AI
AI_PROVIDER=openai_compatible
AI_API_KEY=YOUR_AI_KEY
AI_MODEL=YOUR_MODEL
AI_BASE_URL=https://api.openai.com/v1

# Research
RESEARCH_PROVIDER=YOUR_PROVIDER
RESEARCH_API_KEY=YOUR_KEY
RESEARCH_API_BASE_URL=YOUR_ENDPOINT

# TTS
TTS_PROVIDER=YOUR_TTS_PROVIDER
TTS_API_KEY=YOUR_TTS_KEY
TTS_API_BASE_URL=YOUR_TTS_ENDPOINT
TTS_VOICE_ID=YOUR_VOICE_ID

# Media / stock / image provider
MEDIA_PROVIDER=YOUR_MEDIA_PROVIDER
MEDIA_API_KEY=YOUR_MEDIA_KEY
MEDIA_API_BASE_URL=YOUR_MEDIA_ENDPOINT

# Local media storage
STORAGE_LOCAL_DIR=/data/storage
PUBLIC_MEDIA_URL=http://localhost:8000/media

# YouTube OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly

# Personal creator policy
REQUIRE_HUMAN_APPROVAL=true
AUTO_PUBLISH=false
DEFAULT_LANGUAGE=en
DEFAULT_VIDEO_MINUTES=8
MAX_VIDEO_MINUTES=30

# SaaS-only integrations are intentionally unused
STRIPE_ENABLED=false
SMTP_ENABLED=false
MULTI_TENANT=false
